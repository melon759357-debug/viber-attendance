<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{DynamicResource OfflineBadgeBackgroundBrush}" />
    </Style>
    <Style x:Key="OnlineStatusPillStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="Background" Value="{DynamicResource OnlineBadgeBackgroundBrush}" />
    </Style>
    <Style x:Key="PendingStatusPillStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="Background" Value="{DynamicResource WarningBadgeBackgroundBrush}" />
    </Style>
    <Style x:Key="ErrorStatusPillStyle" TargetType="Border" BasedOn="{StaticResource StatusPillStyle}">
        <Setter Property="Background" Value="{DynamicResource ErrorBadgeBackgroundBrush}" />
    </Style>
    <Style x:Key="StatusTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>
