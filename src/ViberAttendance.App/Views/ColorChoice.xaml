<UserControl x:Class="ViberAttendance.App.Views.ColorChoice"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="40">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="72" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBox VerticalContentAlignment="Center" Text="{Binding Color, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
        <Button x:Name="Swatch" Grid.Column="2" MinWidth="64" Click="OpenPicker" Content="选择" Style="{StaticResource SmallActionButtonStyle}" />
        <Popup x:Name="Picker" PlacementTarget="{Binding ElementName=Swatch}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Margin="0,4,0,0" Padding="10" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="8">
                <StackPanel Width="228">
                    <UniformGrid x:Name="Swatches" Columns="8" />
                    <TextBlock Margin="0,8,0,2" Foreground="#344054" Text="红" />
                    <Slider x:Name="RedSlider" Maximum="255" ValueChanged="PreviewChannel" />
                    <TextBlock Margin="0,4,0,2" Foreground="#344054" Text="绿" />
                    <Slider x:Name="GreenSlider" Maximum="255" ValueChanged="PreviewChannel" />
                    <TextBlock Margin="0,4,0,2" Foreground="#344054" Text="蓝" />
                    <Slider x:Name="BlueSlider" Maximum="255" ValueChanged="PreviewChannel" />
                    <Button Margin="0,8,0,0" Height="30" Click="AcceptColor" Content="用这个颜色" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
