<UserControl x:Class="ViberAttendance.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ViberAttendance.App.Controls"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="HistoryRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style x:Key="HistoryHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="HistoryCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="HistoryTimeCellStyle" TargetType="DataGridCell" BasedOn="{StaticResource TimeCellStyle}">
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="HistoryTimeHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource TimeHeaderStyle}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Text="历史记录" />
            <TextBlock Margin="0,6,0,0" Style="{StaticResource CaptionTextStyle}" Text="{Binding StatusMessage}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="12,10" Style="{StaticResource FlatCardStyle}">
            <WrapPanel>
                <ComboBox Width="160" Margin="0,0,8,8" ItemsSource="{Binding DateFilterOptions}"
                          SelectedItem="{Binding SelectedDateFilter}"
                          ToolTip="按日期筛选" />
                <Grid Width="220" Margin="0,0,8,8">
                    <TextBox x:Name="SearchBox" Padding="34,7,12,7" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <Path Width="16" Height="16" Margin="11,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                          Data="{StaticResource SearchIconGeometry}" Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" IsHitTestVisible="False" />
                    <TextBlock Margin="34,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" IsHitTestVisible="False" Text="搜索成员或记录">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button MinWidth="72" Margin="0,0,8,8" Style="{StaticResource SmallActionButtonStyle}" Command="{Binding ImportArchiveCommand}" Content="导入" />
                <Button MinWidth="72" Margin="0,0,8,8" Style="{StaticResource SmallActionButtonStyle}" Command="{Binding ExportArchiveCommand}" Content="导出" />
                <Button MinWidth="72" Margin="0,0,8,8" Style="{StaticResource SmallActionButtonStyle}" Foreground="{DynamicResource ErrorRedBrush}" Command="{Binding ClearCommand}" Content="清空" />
            </WrapPanel>
        </Border>

        <controls:ShrinkToContent Grid.Row="4" MaxHeight="228" VerticalAlignment="Top">
            <Border Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,8,16,4">
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Text="通话记录" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,6,6" Style="{StaticResource SmallActionButtonStyle}" Command="{Binding WriteSheetCommand}" Content="写入表格" />
                            <Button Margin="0,0,6,6" Style="{StaticResource SmallActionButtonStyle}" Command="{Binding ExportCommand}" Content="导出这场" />
                            <Button Margin="0,0,4,6" Style="{StaticResource SmallActionButtonStyle}" Foreground="{DynamicResource ErrorRedBrush}" BorderBrush="Transparent" Command="{Binding DeleteCommand}" ToolTip="删除所选记录">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14" Data="{StaticResource TrashIconGeometry}" Stretch="Uniform" Stroke="{DynamicResource ErrorRedBrush}" StrokeThickness="1.4" />
                                    <TextBlock Margin="6,0,0,0" Foreground="{DynamicResource ErrorRedBrush}" Text="删除" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,0,6" Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="刷新">
                                <Path Width="16" Height="16" Data="{StaticResource RefreshIconGeometry}" Stretch="Uniform"
                                      Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.5" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding FilteredRecords}"
                              SelectedItem="{Binding SelectedRecord}"
                              AutoGenerateColumns="False"
                              RowStyle="{StaticResource HistoryRowStyle}"
                              ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}"
                              CellStyle="{StaticResource HistoryCellStyle}"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecords}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding CallDate, Mode=OneWay}" Width="*" MinWidth="120" />
                            <DataGridTextColumn Header="开始" Binding="{Binding StartedAt, Mode=OneWay}" Width="96" />
                            <DataGridTextColumn Header="结束" Binding="{Binding EndedAt, Mode=OneWay}" Width="96" />
                            <DataGridTextColumn Header="持续时长" Binding="{Binding TotalDuration, Mode=OneWay}" Width="104" />
                            <DataGridTextColumn Header="人数" Binding="{Binding ParticipantCount, Mode=OneWay}" Width="72" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText, Mode=OneWay}" Width="88" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="16,8,16,12" Text="暂无历史记录">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecords}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </controls:ShrinkToContent>

        <controls:ShrinkToContent Grid.Row="6" VerticalAlignment="Top">
            <Border Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="16,8,16,4">
                        <TextBlock FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Text="成员明细" />
                        <Button Margin="0,8,0,0" HorizontalAlignment="Left" Style="{StaticResource SmallActionButtonStyle}" Foreground="{DynamicResource ErrorRedBrush}" Command="{Binding DeleteIntervalCommand}" Content="删除这段" />
                    </StackPanel>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Details}"
                              SelectedItem="{Binding SelectedInterval}"
                              AutoGenerateColumns="False"
                              RowStyle="{StaticResource HistoryRowStyle}"
                              ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}"
                              CellStyle="{StaticResource HistoryCellStyle}"
                              ScrollViewer.CanContentScroll="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding DisplayName, Mode=OneWay}" Width="1.5*" MinWidth="120" />
                            <DataGridTextColumn Header="自定义号码" Binding="{Binding CustomNumber, Mode=OneWay}" Width="140" />
                            <DataGridTextColumn Header="内部编号" Binding="{Binding StableUiIdentity, Mode=OneWay}" Width="1.3*" MinWidth="120" />
                            <DataGridTextColumn Header="上线时间" Binding="{Binding OnlineAt, Mode=OneWay}" Width="104" />
                            <DataGridTextColumn Header="下线时间" Binding="{Binding OfflineAt, Mode=OneWay}" Width="104" />
                            <DataGridTextColumn Header="在线时长" Binding="{Binding Duration, Mode=OneWay}" Width="104" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText, Mode=OneWay}" Width="88" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Margin="16,8,16,12" Text="选择上方一场通话后，这里显示每人的上下线。">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </controls:ShrinkToContent>
    </Grid>
    </ScrollViewer>
</UserControl>
