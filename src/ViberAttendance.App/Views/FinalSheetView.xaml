<UserControl x:Class="ViberAttendance.App.Views.FinalSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ViberAttendance.App.Views"
             Background="Transparent">
    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="最终" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="点登记后，把日期、符号、分钟和上下线时间写进时间列" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="720" Margin="0,0,18,24" HorizontalAlignment="Left">
                <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <CheckBox Margin="0,0,0,16" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.SheetSync.TimeEnabled}" Content="写入最终表格" />
                        <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="表格链接" />
                        <TextBox Margin="0,0,0,12" Text="{Binding Settings.SheetSync.TimeSpreadsheetUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="工作表名称" />
                        <TextBox Margin="0,0,0,14" Text="{Binding Settings.SheetSync.TimeSheetName, UpdateSourceTrigger=PropertyChanged}" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="姓名列" />
                                <TextBox Text="{Binding Settings.SheetSync.NameColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="时间列" />
                                <TextBox Text="{Binding Settings.SheetSync.TimeColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,4" Text="起始行" />
                                <TextBox Text="{Binding Settings.SheetSync.StartRow, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Margin="0,0,0,4" Text="结束行" />
                                <TextBox Text="{Binding Settings.SheetSync.EndRow, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="只在起始行到结束行里按姓名更新。点登记才写入，不会按间隔自动写最终表。上线和下线时间写在时间列里。" />
                    </StackPanel>
                </Border>

                <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="符号和颜色方案" />
                        <ComboBox Margin="0,12,0,8" ItemsSource="{Binding Schemes}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedScheme}" />
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Content="新建" Command="{Binding AddSchemeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Margin="0,0,8,0" Content="复制" Command="{Binding DuplicateSchemeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="删除" Command="{Binding DeleteSchemeCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="方案名称" />
                                <TextBox Text="{Binding SelectedScheme.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="后缀" />
                                <TextBox Text="{Binding SelectedScheme.Suffix, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Margin="0,0,0,4" Text="默认符号" />
                                <TextBox Text="{Binding SelectedScheme.DefaultSymbol, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Margin="0,0,0,4" Text="默认颜色" />
                                <views:ColorChoice Color="{Binding SelectedScheme.DefaultColor, Mode=TwoWay}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Margin="0,0,0,4" Text="大于等于多少分钟" />
                                <TextBox Text="{Binding SelectedScheme.PrefixMinimumMinutes, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Margin="0,0,0,4" Text="日期前面自动加的文字" />
                                <TextBox Text="{Binding SelectedScheme.PrefixText, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="大于等于多少分钟" />
                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Text="符号" />
                            <TextBlock Grid.Column="4" Style="{StaticResource CaptionTextStyle}" Text="颜色" />
                        </Grid>
                        <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding SelectedTiers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding MinimumMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Text="{Binding Symbol, UpdateSourceTrigger=PropertyChanged}" />
                                        <views:ColorChoice Grid.Column="4" Color="{Binding Color, Mode=TwoWay}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal">
                            <Button Margin="0,0,8,0" Content="添加档位" Command="{Binding AddTierCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="删除最后一档" Command="{Binding RemoveTierCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Text="符号按你输入的原样写入。时长写成 120分钟。达到上面的分钟数时，文字加在日期前面。示例：优秀 11/18 ★ 120分钟 VB 上线 19:01 下线 21:01" />
                    </StackPanel>
                </Border>

                <views:SheetWriteMethodView Margin="0,0,0,16" />

                <StackPanel>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <Button MinWidth="126" Margin="0,0,8,0" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RegisterTimeCommand}" Content="登记" />
                        <Button MinWidth="126" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SaveCommand}" Content="保存" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Text="{Binding StatusMessage}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
