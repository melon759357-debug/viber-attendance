<UserControl x:Class="ViberAttendance.App.Views.LiveSheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ViberAttendance.App.Views"
             Background="Transparent">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="实时" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="把每人的上线、下线、状态和累计时长写入一张表格" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,16">
                <Border Margin="0,0,0,16" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <CheckBox Margin="0,0,0,16" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.SheetSync.DetailEnabled}" Content="写入实时表格" />
                        <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="写入间隔（秒）" />
                        <TextBox Margin="0,0,0,6" Text="{Binding Settings.SheetSync.IntervalSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,14" Style="{StaticResource CaptionTextStyle}" Text="这个间隔和有人上线或下线时，只写实时表格。最终表格在点击登记时写入。勾选导出自定义号码后，改号码只补最终表格里已有的人的号码。" />
                        <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="表格链接" />
                        <TextBox Margin="0,0,0,12" Text="{Binding Settings.SheetSync.DetailSpreadsheetUrl, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,0,0,7" FontWeight="SemiBold" Text="工作表名称" />
                        <TextBox Margin="0,0,0,14" Text="{Binding Settings.SheetSync.DetailSheetName, UpdateSourceTrigger=PropertyChanged}" />
                        <WrapPanel>
                            <StackPanel Width="200" Margin="0,0,12,10">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="姓名列" />
                                <TextBox Text="{Binding Settings.SheetSync.DetailNameColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,10">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="上线列" />
                                <TextBox Text="{Binding Settings.SheetSync.DetailOnlineColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,10">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="下线列" />
                                <TextBox Text="{Binding Settings.SheetSync.DetailOfflineColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,10">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="状态列" />
                                <TextBox Text="{Binding Settings.SheetSync.DetailStatusColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,10">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="时长列" />
                                <TextBox Text="{Binding Settings.SheetSync.DetailDurationColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Width="200" Margin="0,0,12,10">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="号码列" />
                                <TextBox Text="{Binding Settings.SheetSync.DetailCodeColumn, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox Margin="0,4,0,8" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding Settings.SheetSync.DetailCodeEnabled}" Content="导出自定义号码" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="号码在左侧栏添加。勾选后，写入时按名字自动填上对应号码，空格不影响对照。不勾选就不会写号码列。号码列不要和上面的列用同一个字母。" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource CaptionTextStyle}" Text="留空就用第一张工作表。列填字母，例如 A、B。同名的人更新原来那一行，时长写成多少分钟。" />
                    </StackPanel>
                </Border>

                <views:SheetWriteMethodView Margin="0,0,0,16" />

                <StackPanel>
                    <Button MinWidth="126" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Data="{StaticResource SaveIconGeometry}" Stretch="Uniform" Stroke="White" StrokeThickness="1.5" />
                            <TextBlock Margin="8,0,0,0" Foreground="White" Text="保存" />
                        </StackPanel>
                    </Button>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" Text="{Binding StatusMessage}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
