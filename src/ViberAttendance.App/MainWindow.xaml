<Window x:Class="ViberAttendance.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ViberAttendance.App.Views"
        xmlns:services="clr-namespace:ViberAttendance.App.Services"
        Title="Viber在线记录"
        Width="1100"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        Icon="Assets/ViberAttendance.png"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Background="{DynamicResource NavigationBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="16,16,12,12">
                    <Border Width="40" Height="40" Background="{DynamicResource LightPurpleBrush}" CornerRadius="12">
                        <Image Width="34" Height="34" Stretch="Uniform"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <BitmapImage UriSource="Assets/ViberAttendance.png" CacheOption="OnLoad" DecodePixelWidth="256" />
                            </Image.Source>
                        </Image>
                    </Border>
                    <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None" Text="Viber 在线记录" />
                    <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" Text="通话考勤助手" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,12,16">
                    <Border Height="1" Margin="0,0,0,12" Background="{DynamicResource DividerBrush}" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="完全本地运行" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource CaptionTextStyle}">
                        <Run Text="版本 " /><Run Text="{x:Static services:AppRelease.Version}" />
                    </TextBlock>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <RadioButton x:Name="CurrentNavButton"
                                 GroupName="MainNavigation"
                                 IsChecked="True"
                                 AutomationProperties.Name="当前记录"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Tag="Current"
                                 Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20" Height="20" Data="{StaticResource RecordIconGeometry}" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="当前记录" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="HistoryNavButton"
                                 GroupName="MainNavigation"
                                 AutomationProperties.Name="历史记录"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Tag="History"
                                 Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20" Height="20" Data="{StaticResource HistoryIconGeometry}" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="历史记录" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LiveSheetNavButton"
                                 GroupName="MainNavigation"
                                 AutomationProperties.Name="实时"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Tag="LiveSheet"
                                 Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20" Height="20" Data="{StaticResource TimerIconGeometry}" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="实时" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FinalSheetNavButton"
                                 GroupName="MainNavigation"
                                 AutomationProperties.Name="最终"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Tag="FinalSheet"
                                 Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20" Height="20" Data="{StaticResource CalendarIconGeometry}" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="最终" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="SettingsNavButton"
                                 GroupName="MainNavigation"
                                 AutomationProperties.Name="设置"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Tag="Settings"
                                 Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20" Height="20" Data="{StaticResource SettingsIconGeometry}" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="设置" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="AdvancedNavButton"
                                 GroupName="MainNavigation"
                                 AutomationProperties.Name="高级诊断"
                                 Style="{StaticResource NavigationButtonStyle}"
                                 Tag="Advanced"
                                 Visibility="Collapsed"
                                 Checked="Navigation_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="20" Height="20" Data="{StaticResource DiagnosticsIconGeometry}" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Text="高级诊断" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Column="1"
                    SelectedIndex="0"
                    Style="{StaticResource ContentOnlyTabControlStyle}">
            <TabItem x:Name="CurrentTab" Header="当前记录">
                <views:CurrentRecordView />
            </TabItem>
            <TabItem x:Name="HistoryTab" Header="历史记录">
                <views:HistoryView />
            </TabItem>
            <TabItem x:Name="LiveSheetTab" Header="实时">
                <views:LiveSheetView />
            </TabItem>
            <TabItem x:Name="FinalSheetTab" Header="最终">
                <views:FinalSheetView />
            </TabItem>
            <TabItem x:Name="SettingsTab" Header="设置">
                <views:SettingsView />
            </TabItem>
            <TabItem x:Name="AdvancedTab" Header="高级诊断" Visibility="Collapsed">
                <views:AdvancedDiagnosticsView />
            </TabItem>
        </TabControl>
    </Grid>
</Window>
